<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1890A4AE"
                android:startColor="#48CFD8DC"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:top="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:centerColor="#26ECEFF1"
                android:endColor="#1090A4AE"
                android:startColor="#30CFD8DC"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
