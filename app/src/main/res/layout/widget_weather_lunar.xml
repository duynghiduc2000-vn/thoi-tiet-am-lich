<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_dark"
    android:padding="14dp">

    <!-- Dòng Âm lịch trên cùng bên trái: chỉ chừa chỗ cho cụm nhiệt độ nhỏ gọn bên phải -->
    <TextView
        android:id="@+id/tv_lunar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/btn_refresh_weather"
        android:layout_marginEnd="6dp"
        android:maxLines="2"
        android:text="Âm: 17/10 - Ngày Quý Mão, Bính Ngọ"
        android:textColor="#4FC3F7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Biểu tượng thời tiết + Nhiệt độ hiện tại trên cùng bên phải -->
    <LinearLayout
        android:id="@+id/btn_refresh_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/tv_weather_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:text="🌦️"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="--°C"
            android:textColor="#4FC3F7"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cột trái (dưới dòng Âm lịch): Dương lịch, Đồng hồ, Cao/Thấp -->
    <LinearLayout
        android:id="@+id/left_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/tv_lunar_date"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/right_column"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Dòng Dương lịch -->
        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thứ Tư • 25/11/2026"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Đồng hồ lớn tự cập nhật -->
        <TextClock
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Nhiệt độ cao / thấp trong ngày -->
        <TextView
            android:id="@+id/tv_min_max_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="▲ --°  ▼ --°"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Cột phải (dưới cụm nhiệt độ): Địa danh, Trạng thái, Độ ẩm & Gió -->
    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/btn_refresh_weather"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:gravity="end|top"
        android:orientation="vertical">

        <!-- Tên địa danh -->
        <TextView
            android:id="@+id/tv_location_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chưa có vị trí"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Trạng thái thời tiết -->
        <TextView
            android:id="@+id/tv_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chạm nhiệt độ để cập nhật"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <!-- Độ ẩm & Gió -->
        <TextView
            android:id="@+id/tv_humidity_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="💧 --% • 💨 --km/h"
            android:textColor="#CFD8DC"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Hàng dưới cùng: 4 mốc giờ bên trái + chữ ký bên phải cùng 1 hàng -->
    <RelativeLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/hourly_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/tv_signature"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hour_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:text="--:-- --°"
                android:textColor="#EEEEEE"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:text="--:-- --°"
                android:textColor="#EEEEEE"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:text="--:-- --°"
                android:textColor="#EEEEEE"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--:-- --°"
                android:textColor="#EEEEEE"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_signature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Gió Độc"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic" />
    </RelativeLayout>

</RelativeLayout>
