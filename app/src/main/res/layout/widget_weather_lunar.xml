<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_dark"
    android:padding="14dp">

    <!-- Lớp hiệu ứng thời tiết hiện tại phủ nền -->
    <ImageView
        android:id="@+id/iv_weather_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.82"
        android:contentDescription="Hiệu ứng thời tiết"
        android:scaleType="fitXY"
        android:src="@drawable/fx_weather_clear" />

    <!-- Dòng Âm lịch trên cùng bên trái: chỉ chừa chỗ cho cụm nhiệt độ bo khung bên phải -->
    <TextView
        android:id="@+id/tv_lunar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/btn_refresh_weather"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="Âm: 17/10 - Ngày Quý Mão, Bính Ngọ"
        android:textColor="#4FC3F7"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Biểu tượng thời tiết + Nhiệt độ hiện tại bo khung ở góc trên bên phải -->
    <LinearLayout
        android:id="@+id/btn_refresh_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_widget_forecast_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/tv_weather_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="🌦️"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="--°C"
            android:textColor="#4FC3F7"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng thẳng hàng: Dương lịch bên trái + Tên địa danh bên phải -->
    <RelativeLayout
        android:id="@+id/date_location_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btn_refresh_weather"
        android:layout_marginTop="3dp">

        <!-- Dòng Dương lịch -->
        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/tv_location_name"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Thứ Tư • 25/11/2026"
            android:textColor="#F4F4F5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tên địa danh -->
        <TextView
            android:id="@+id/tv_location_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Chưa có vị trí"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Cột trái (dưới hàng ngày dương/địa điểm): Đồng hồ tự cập nhật, giới hạn chặt trên bottom_row -->
    <LinearLayout
        android:id="@+id/left_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/date_location_row"
        android:layout_alignParentStart="true"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="2dp"
        android:layout_toStartOf="@+id/right_column"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cột phải (dưới hàng ngày dương/địa điểm): Trạng thái, Độ ẩm & Gió, Cao/Thấp -->
    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/date_location_row"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <!-- Trạng thái thời tiết -->
        <TextView
            android:id="@+id/tv_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Chạm nhiệt độ để cập nhật"
            android:textColor="#E4E4E7"
            android:textSize="11sp" />

        <!-- Độ ẩm & Gió -->
        <TextView
            android:id="@+id/tv_humidity_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="💧 --% • 💨 --km/h"
            android:textColor="#D4D4D8"
            android:textSize="10.5sp" />

        <!-- Nhiệt độ cao / thấp trong ngày (dưới độ ẩm & gió bên phải) -->
        <TextView
            android:id="@+id/tv_min_max_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="▲ --°  ▼ --°"
            android:textColor="#4FC3F7"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng dưới cùng: 7 ô vuông dự báo ở góc dưới bên trái + chữ ký thẳng hàng bên phải -->
    <RelativeLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/forecast_7days_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/tv_signature"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Ô vuông ngày 1 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_1"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T6"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_1_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="⛅"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 2 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_2"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T7"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_2_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="⛅"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 3 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_3"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="CN"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_3_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="☀️"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 4 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_4"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T2"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_4_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="🌧️"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 5 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_5"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_5_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T3"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_5_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="⛅"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 6 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_6"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="1.5dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_6_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T4"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_6_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="☀️"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Ô vuông ngày 7 -->
            <LinearLayout
                android:id="@+id/card_forecast_day_7"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_widget_forecast_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tv_forecast_day_7_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T5"
                    android:textColor="#E4E4E7"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_forecast_day_7_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="⛅"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_signature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Gió Độc"
            android:textColor="#4FC3F7"
            android:textSize="10.5sp"
            android:textStyle="italic|bold" />
    </RelativeLayout>

</RelativeLayout>
