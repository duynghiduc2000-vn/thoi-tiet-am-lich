<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_dark"
    android:padding="16dp">

    <!-- Lớp hiệu ứng thời tiết hiện tại phủ nền -->
    <ImageView
        android:id="@+id/iv_weather_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.82"
        android:contentDescription="Hiệu ứng thời tiết"
        android:scaleType="fitXY"
        android:src="@drawable/fx_weather_clear" />

    <!-- Dòng Âm lịch trên cùng bên trái: chỉ chừa chỗ cho cụm nhiệt độ nhỏ gọn bên phải -->
    <TextView
        android:id="@+id/tv_lunar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/btn_refresh_weather"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="Âm: 17/10 - Ngày Quý Mão, Bính Ngọ"
        android:textColor="#4FC3F7"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Biểu tượng thời tiết + Nhiệt độ hiện tại trên cùng bên phải -->
    <LinearLayout
        android:id="@+id/btn_refresh_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/tv_weather_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="🌦️"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/tv_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="--°C"
            android:textColor="#4FC3F7"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng thẳng hàng: Dương lịch bên trái + Tên địa danh bên phải -->
    <RelativeLayout
        android:id="@+id/date_location_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btn_refresh_weather"
        android:layout_marginTop="4dp">

        <!-- Dòng Dương lịch -->
        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/tv_location_name"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Thứ Tư • 25/11/2026"
            android:textColor="#F4F4F5"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Tên địa danh -->
        <TextView
            android:id="@+id/tv_location_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Chưa có vị trí"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Cột trái (dưới hàng ngày dương/địa điểm): Đồng hồ lớn tự cập nhật -->
    <LinearLayout
        android:id="@+id/left_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/date_location_row"
        android:layout_alignParentStart="true"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/right_column"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cột phải (dưới hàng ngày dương/địa điểm): Trạng thái, Độ ẩm & Gió, Cao/Thấp -->
    <LinearLayout
        android:id="@+id/right_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_row"
        android:layout_below="@+id/date_location_row"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:gravity="end|top"
        android:orientation="vertical">

        <!-- Trạng thái thời tiết -->
        <TextView
            android:id="@+id/tv_weather_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Chạm nhiệt độ để cập nhật"
            android:textColor="#E4E4E7"
            android:textSize="11.5sp" />

        <!-- Độ ẩm & Gió -->
        <TextView
            android:id="@+id/tv_humidity_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="💧 --% • 💨 --km/h"
            android:textColor="#D4D4D8"
            android:textSize="11sp" />

        <!-- Nhiệt độ cao / thấp trong ngày (dưới độ ẩm & gió bên phải) -->
        <TextView
            android:id="@+id/tv_min_max_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="▲ --°  ▼ --°"
            android:textColor="#4FC3F7"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng dưới cùng: 4 mốc giờ bên trái + chữ ký bên phải cùng 1 hàng -->
    <RelativeLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/hourly_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/tv_signature"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hour_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="--:-- --°"
                android:textColor="#E4E4E7"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="--:-- --°"
                android:textColor="#E4E4E7"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="--:-- --°"
                android:textColor="#E4E4E7"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_hour_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="--:-- --°"
                android:textColor="#E4E4E7"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_signature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#88000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Gió Độc"
            android:textColor="#4FC3F7"
            android:textSize="12sp"
            android:textStyle="italic|bold" />
    </RelativeLayout>

</RelativeLayout>
